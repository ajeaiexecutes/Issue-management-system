{
  "name": "issue-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "install:all": "npm install",
    "db:generate": "npm run generate -w backend",
    "db:migrate": "npm run migrate -w backend",
    "db:seed": "npm run seed -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
